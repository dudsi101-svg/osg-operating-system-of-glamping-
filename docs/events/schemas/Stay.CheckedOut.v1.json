{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stay.CheckedOut v1 payload",
  "type": "object",
  "required": ["stay_id", "property_id", "checkout_at", "unit_ids"],
  "properties": {
    "stay_id": {"type": "string", "format": "uuid"},
    "property_id": {"type": "string", "format": "uuid"},
    "checkout_at": {"type": "string", "format": "date-time"},
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "next_expected_arrival_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}